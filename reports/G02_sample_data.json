        "texts": [
          {
            "source_row": 4904,
            "accept_dialogue": "　　[焦急地拉着仙友，仿佛有什么迫切要对仙友说]我怕来到这里语言不通，便把我的故事画了下来。[只见她迅速拿出了一份手札]",
            "quest_description": "　　阿卓确定仙友的身份后，大为激动，对仙友诉说起了她的故事。",
            "hint_text": "　　听<target:5380>的故事。<item:（提示：点击带有下划线的文字便可以出现寻路路线。）>",
            "progress_dialogue": "　　我必须要早些回到女儿国。",
            "completion_dialogue": "　　[仙友终是抵不住阿卓可怜祈求的眼神，欣然应允，阿卓高兴地转起了圈]太好了！我们现在就出发吧！",
            "source_file": "mb/quest/quest_text.txt"
          }
        ],
