{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xunxian-quest-archive",
  "main": "src/entry.py",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "quests.xunxian.wiki",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "QUEST_DB",
      "database_name": "xunxian-quest-archive-v2",
      "database_id": "ca43e569-0c8b-429a-ae91-46ed990b1567"
    },
    {
      "binding": "VISITS_DB",
      "database_name": "xunxian-visits",
      "database_id": "c916e43e-4e69-4a1e-8c67-a23ebd1a5896"
    }
  ]
}
